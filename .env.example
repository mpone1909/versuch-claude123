# DaRa Multi-Agent System - Beispiel-Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle die Werte aus

# ============================================================================
# Pfad-Konfiguration
# ============================================================================
# DARA_PATH_DATA_DIR=/pfad/zu/daten
# DARA_PATH_EXPERIMENTS_DIR=/pfad/zu/experimenten
# DARA_PATH_RESULTS_DIR=/pfad/zu/ergebnissen
# DARA_PATH_LOGS_DIR=/pfad/zu/logs

# ============================================================================
# DaRa-spezifische Parameter
# ============================================================================
# Standard-Probanden (kommasepariert)
# DARA_DEFAULT_PROBAND_IDS=P1,P2,P3

# Verarbeitungs-Parameter
# DARA_MIN_VALID_PROBANDS=2
# DARA_BATCH_SIZE=1000

# Analyse-Schwellenwerte
# DARA_BASELINE_THRESHOLD=0.3
# DARA_PEAK_THRESHOLD=0.8
# DARA_ANOMALY_STD_MULTIPLIER=2.5

# Datenfeld-Konfiguration
# DARA_PRIMARY_NUMERIC_FIELD=value
# DARA_ADDITIONAL_NUMERIC_FIELDS=score,duration

# ============================================================================
# Notion Integration
# ============================================================================
# Notion API Token (von https://www.notion.so/my-integrations)
# NOTION_API_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Google Drive Integration
# ============================================================================
# Pfad zur Google Credentials JSON-Datei
# GOOGLE_CREDENTIALS_PATH=/pfad/zu/credentials.json

# Google Drive Folder ID (aus der URL des Zielordners)
# GDRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Orchestrierungs-Optionen
# ============================================================================
# Report-Erstellung
# ORCHESTRATOR_CREATE_NOTION_REPORT=false
# ORCHESTRATOR_CREATE_GDRIVE_DOC=false
# ORCHESTRATOR_CREATE_GDRIVE_SHEET=false

# Logging
# ORCHESTRATOR_LOG_LEVEL=INFO
# ORCHESTRATOR_VERBOSE=false

# ============================================================================
# Hinweise
# ============================================================================
# - Entferne das '#' am Anfang der Zeile, um eine Variable zu aktivieren
# - Speichere NIEMALS echte API-Schlüssel oder Tokens im Repository
# - Die .env-Datei ist in .gitignore und wird nicht versioniert
# - Ohne API-Konfiguration arbeiten die Reporter im Simulations-Modus
